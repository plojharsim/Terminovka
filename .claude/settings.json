{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run lint*)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(npx prisma db push*)",
      "Bash(npx vercel*)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma db push*--force-reset*)",
      "Bash(npx prisma db push*--accept-data-loss*)",
      "Bash(npx prisma db execute*)",
      "Bash(npm run db:seed*)",
      "Read(./terminovka_backup.json)"
    ]
  }
}
